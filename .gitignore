# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/mobile/node_modules
/mobile/.expo
/mobile/dist
/mobile/android
/mobile/ios
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Firebase admin / service-account JSON — actual secret material that
# signs FCM messages server-side. Never commit. Lives in env as
# FIREBASE_SERVICE_ACCOUNT_JSON_B64 (base64-encoded) and is loaded by
# `lib/fcm.ts`.
firebase-service-account*.json

# `mobile/google-services.json` is intentionally NOT ignored — Firebase's
# Android client config is designed to ship inside the APK (the API key
# is publicly visible in any signed release). Security comes from the
# SHA-256 fingerprint check Firebase runs against the registered app,
# not from secrecy of this file. Keeping it tracked means EAS Build
# picks it up via VCS without an .easignore workaround.

# vercel
.vercel

# legacy reference (kept locally as design source-of-truth, not in git)
/legacy

# claude code session state
/.claude

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env*.local
