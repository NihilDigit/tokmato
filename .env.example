# tokmato — required environment variables
# Copy this file to .env.local for development; configure these in Vercel for production.

# ─── NextAuth (Auth.js v5) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical app origin. Production should be:
# https://tokmato.nihildigit.dev
# Local development can leave this unset or use http://localhost:3000.
AUTH_URL=

# GitHub OAuth app — create at https://github.com/settings/developers
# Authorization callback URL (dev): http://localhost:3000/api/auth/callback/github
# Authorization callback URL (prod): https://tokmato.nihildigit.dev/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── Vercel KV (Upstash Redis) ────────────────────────────────────────
# When you enable the Vercel Marketplace Upstash integration, these are auto-injected.
# For local dev, paste them from the Vercel dashboard or your Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV names (also supported as fallback)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────
# Generate locally: bunx web-push generate-vapid-keys --json
# Public key is also exposed to the client as NEXT_PUBLIC_*.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# ─── Upstash QStash (delayed push delivery) ───────────────────────────
# Get from https://console.upstash.com/qstash → Details (.env tab)
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: where QStash should call back. Auto-derived from VERCEL_URL
# in prod; set this when tunneling locally (e.g. https://abc.ngrok.app).
QSTASH_CALLBACK_URL=
