# Copy to .env.local for local dev. Expo inlines EXPO_PUBLIC_* at bundle
# time. Override the API host so the RN client hits the local Next.js
# dev server instead of prod.
#
# Android emulator → 10.0.2.2 maps to the host's localhost.
# iOS simulator    → localhost works directly.
# Physical device  → use the host's LAN IP, must be on the same wifi.
EXPO_PUBLIC_API_BASE=http://10.0.2.2:3000
