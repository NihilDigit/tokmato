{
  "expo": {
    "name": "tokmato",
    "slug": "tokmato",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tokmato",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4efe6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.nihildigit.tokmato"
    },
    "android": {
      "package": "dev.nihildigit.tokmato",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#f4efe6"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#d65a3a",
          "defaultChannel": "tokmato-default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "https://tokmato.nihildigit.dev",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "dbb9b33b-3485-4264-a0d5-566fa33db038"
      }
    },
    "owner": "nihildigit"
  }
}
